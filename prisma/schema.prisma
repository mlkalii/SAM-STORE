// SAMRUX marketplace schema.
//
// Mirrors the in-memory domain stores one-to-one, so the migration path is
// "implement each store interface against these tables" — no behavioural
// change above the store layer. Conventions used throughout:
//
//   id          cuid primary keys (stable across environments, no sequence
//               contention, safe in URLs)
//   createdAt / updatedAt / deletedAt
//               audit fields on every mutable table; soft delete everywhere a
//               row can be referenced by history (never hard-delete an order's
//               product, a review's author, a payout's seller)
//   Money       integer minor units (Int), exactly as the application layer —
//               the ticker (USDT) is presentation only
//   Indexes     every foreign key, every column the query engine filters on

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL everywhere: local Postgres, Supabase, RDS. Connection URLs live
  // in prisma.config.ts (DATABASE_URL / DIRECT_DATABASE_URL), per Prisma 7.
  provider = "postgresql"
}

/* ------------------------------------------------------------------------ */
/*  Identity                                                                 */
/* ------------------------------------------------------------------------ */

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  emailVerified   Boolean   @default(false)
  sessionVersion  Int       @default(1)
  avatarColor     String    @default("from-zinc-700 to-zinc-500")
  phone           String?
  marketingOptIn  Boolean   @default(false)
  linkedProviders String[]  @default([])

  addresses     Address[]
  orders        Order[]
  notifications Notification[]
  authTokens    AuthToken[]
  reviews       Review[]
  threads       MessageThread[]
  follows       SellerFollow[]
  seller        Seller?
  auditEntries  AuditLog[]     @relation("AuditActorUser")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([deletedAt])
}

model Address {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  label     String
  recipient String
  line1     String
  line2     String?
  city      String
  state     String?
  postcode  String
  country   String
  phone     String?
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model AuthToken {
  token     String   @id
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  kind      String // verify-email | reset-password
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

model StaffUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  role           String // super-admin | admin | manager | staff | support
  passwordHash   String
  active         Boolean   @default(true)
  sessionVersion Int       @default(1)
  avatarColor    String    @default("from-zinc-700 to-zinc-500")
  lastSeenAt     DateTime?

  auditEntries AuditLog[] @relation("AuditActorStaff")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  kind      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/* ------------------------------------------------------------------------ */
/*  Marketplace sellers                                                      */
/* ------------------------------------------------------------------------ */

model Seller {
  id          String  @id @default(cuid())
  slug        String  @unique
  owner       User    @relation(fields: [ownerUserId], references: [id])
  ownerUserId String  @unique
  storeName   String
  description String  @default("")
  logoUrl     String?
  bannerUrl   String?
  gradient    String  @default("from-zinc-800 to-zinc-600")

  // Business record. Tax id stored masked; the full value belongs in a
  // dedicated KYC vault, never in the application database.
  legalName          String
  businessType       String
  taxIdMasked        String
  registrationNumber String?
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  postcode           String
  country            String  @default("US")
  contactName        String
  contactEmail       String
  contactPhone       String

  // Payout destination — last four digits only.
  bankAccountName  String?
  bankAccountLast4 String?
  bankRoutingLast4 String?
  usdtWallet       String?

  status          String    @default("pending") // draft|pending|approved|suspended|rejected
  statusNote      String?
  statusChangedAt DateTime?
  statusChangedBy String?

  commissionOverride Int? // percentage points

  rating        Float  @default(0)
  reviewCount   Int    @default(0)
  followerCount Int    @default(0)
  departments   String[] @default([])
  featured      Boolean  @default(false)
  dispatchHours Int      @default(24)
  returnDays    Int      @default(30)

  products      Product[]
  verifications SellerVerification[]
  ledgerEntries LedgerEntry[]
  payouts       Payout[]
  reviews       Review[]
  threads       MessageThread[]
  followers     SellerFollow[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([featured])
}

model SellerVerification {
  id          String    @id @default(cuid())
  seller      Seller    @relation(fields: [sellerId], references: [id])
  sellerId    String
  kind        String // identity | business | tax | banking
  status      String    @default("not-started")
  documentRef String?
  note        String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, kind])
}

model SellerFollow {
  seller     Seller   @relation(fields: [sellerId], references: [id])
  sellerId   String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  followedAt DateTime @default(now())

  @@id([sellerId, userId])
  @@index([userId])
}

/* ------------------------------------------------------------------------ */
/*  Catalogue                                                                */
/* ------------------------------------------------------------------------ */

model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  brand            String
  sku              String  @unique
  shortDescription String  @default("")
  longDescription  String  @default("")
  features         String[] @default([])
  specifications   Json     @default("[]")

  price          Int
  compareAtPrice Int?
  costPrice      Int?

  rating      Float @default(0)
  reviewCount Int   @default(0)

  stockCount Int    @default(0)
  category   String
  subcategory String @default("")
  tags       String[] @default([])

  seller   Seller? @relation(fields: [sellerId], references: [id])
  sellerId String?

  images   ProductImage[]
  variants ProductVariant[]

  status   String  @default("published") // published | draft | archived
  visible  Boolean @default(true)
  barcode  String?
  videoUrl String?
  seoTitle       String?
  seoDescription String?

  releasedAt DateTime @default(now())
  gradient   String   @default("from-zinc-800 to-zinc-600")
  dispatchHours Int   @default(48)

  featured   Boolean @default(false)
  bestSeller Boolean @default(false)
  newArrival Boolean @default(false)
  trending   Boolean @default(false)

  reviews    Review[]
  orderLines OrderLine[]
  movements  StockMovement[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?

  @@index([category, status, visible])
  @@index([sellerId])
  @@index([brand])
  @@index([price])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  view      String // main | detail | in-use | angle | scale | packaging
  alt       String
  src       String
  thumbnail String
  credit    String  @default("")
  width     Int     @default(1600)
  height    Int     @default(1600)
  position  Int     @default(0)

  @@index([productId, position])
}

model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  key       String // variant id within the product, e.g. "graphite"
  label     String
  hex       String?
  position  Int     @default(0)

  @@unique([productId, key])
}

model StockMovement {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  warehouseId String?
  delta       Int
  reason      String
  note        String?
  actor       String?
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

/* ------------------------------------------------------------------------ */
/*  Orders                                                                   */
/* ------------------------------------------------------------------------ */

model Order {
  id        String @id @default(cuid())
  reference String @unique
  user      User   @relation(fields: [userId], references: [id])
  userId    String
  email     String

  status String @default("processing")

  subtotal         Int
  discountTotal    Int @default(0)
  shippingTotal    Int @default(0)
  shippingDiscount Int @default(0)
  taxTotal         Int @default(0)
  giftCardTotal    Int @default(0)
  grandTotal       Int
  currency         String @default("USDT")
  taxLines         Json   @default("[]")
  appliedDiscounts Json   @default("[]")

  shippingAddress Json
  billingAddress  Json

  shippingMethodId    String
  shippingMethodLabel String
  deliveryEstimate    Json

  notes          String?
  couponCodes    String[] @default([])
  giftCardCodes  String[] @default([])
  trackingNumber String?

  returnRequest Json?
  refund        Json?

  lines    OrderLine[]
  events   OrderEvent[]
  payments PaymentTransaction[]

  placedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, placedAt])
  @@index([status])
  @@index([placedAt])
}

model OrderLine {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  // Denormalised snapshot: the line survives catalogue edits and deletions.
  product      Product? @relation(fields: [productId], references: [id])
  productId    String?
  slug         String
  variantKey   String
  variantLabel String
  name         String
  brand        String
  category     String
  sellerId     String?
  sellerName   String?
  image        String  @default("")

  quantity     Int
  unitPrice    Int
  comparePrice Int?
  lineSubtotal Int
  lineDiscount Int @default(0)

  @@index([orderId])
  @@index([sellerId])
  @@index([slug])
}

model OrderEvent {
  id      String   @id @default(cuid())
  order   Order    @relation(fields: [orderId], references: [id])
  orderId String
  status  String
  label   String
  detail  String?
  at      DateTime @default(now())

  @@index([orderId, at])
}

/* ------------------------------------------------------------------------ */
/*  Payments                                                                 */
/* ------------------------------------------------------------------------ */

model PaymentTransaction {
  id       String @id @default(cuid())
  order    Order  @relation(fields: [orderId], references: [id])
  orderId  String
  provider String // stripe | paypal | apple-pay | google-pay | bank-transfer | cash-on-delivery | usdt

  kind      String // intent | capture | refund | payout-settlement
  status    String // pending | authorised | captured | failed | refunded
  amount    Int
  currency  String  @default("USDT")
  reference String // provider-side id — never card data
  detail    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([provider, reference])
  @@index([status])
}

/* ------------------------------------------------------------------------ */
/*  Marketplace money                                                        */
/* ------------------------------------------------------------------------ */

model LedgerEntry {
  id       String @id @default(cuid())
  seller   Seller @relation(fields: [sellerId], references: [id])
  sellerId String
  kind     String // sale | commission | refund | commission-reversal | payout | adjustment
  amount   Int // positive credits the seller, negative debits
  currency String @default("USDT")
  description String
  orderId        String?
  orderReference String?
  payout   Payout? @relation(fields: [payoutId], references: [id])
  payoutId String?

  createdAt DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([orderId])
}

model Payout {
  id        String @id @default(cuid())
  reference String @unique
  seller    Seller @relation(fields: [sellerId], references: [id])
  sellerId  String
  amount    Int
  currency  String @default("USDT")
  status    String @default("requested") // requested|approved|processing|paid|rejected
  destination    String
  note           String?
  processedBy    String?
  processedAt    DateTime?
  transactionRef String?

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, createdAt])
  @@index([status])
}

model CommissionRule {
  id       String  @id @default(cuid())
  kind     String // percentage | fixed | category
  label    String
  value    Int // percentage points, or minor units for `fixed`
  category String?
  sellerId String?
  active   Boolean @default(true)
  priority Int     @default(10)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active, priority])
}

/* ------------------------------------------------------------------------ */
/*  Promotions                                                               */
/* ------------------------------------------------------------------------ */

model Promotion {
  id    String  @id @default(cuid())
  code  String? @unique
  kind  String // percentage | fixed | free-shipping | bogo | bundle | flash
  label String
  description String @default("")
  value       Int
  minSubtotal Int?
  category    String?
  slugs       String[] @default([])
  startsAt    DateTime?
  endsAt      DateTime?
  automatic   Boolean  @default(false)
  usageLimit  Int?
  usageCount  Int      @default(0)
  oncePerCustomer Boolean @default(false)
  active          Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active])
}

model GiftCard {
  code           String  @id
  initialBalance Int
  balance        Int
  currency       String  @default("USDT")
  active         Boolean @default(true)
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------------ */
/*  Reviews and messaging                                                    */
/* ------------------------------------------------------------------------ */

model Review {
  id       String  @id @default(cuid())
  target   String // product | seller
  product  Product? @relation(fields: [productId], references: [id])
  productId String?
  seller   Seller  @relation(fields: [sellerId], references: [id])
  sellerId String
  author   User    @relation(fields: [authorId], references: [id])
  authorId String

  rating           Int
  title            String
  body             String
  verifiedPurchase Boolean @default(false)
  orderId          String?

  status         String    @default("pending") // pending | published | rejected
  moderatedAt    DateTime?
  moderatedBy    String?
  moderationNote String?
  helpfulCount   Int       @default(0)
  replyBody      String?
  replyAt        DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId, status])
  @@index([sellerId, status])
  @@index([authorId])
}

model MessageThread {
  id         String @id @default(cuid())
  kind       String // question | order | return | general
  subject    String
  customer   User   @relation(fields: [customerId], references: [id])
  customerId String
  seller     Seller @relation(fields: [sellerId], references: [id])
  sellerId   String
  productSlug String?
  orderId     String?
  status      String @default("open") // open | answered | closed
  visibility  String @default("private")

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([productSlug, visibility, status])
}

model Message {
  id       String        @id @default(cuid())
  thread   MessageThread @relation(fields: [threadId], references: [id])
  threadId String

  authorRole String // customer | seller | admin
  authorId   String
  authorName String
  body       String
  attachments Json @default("[]")

  readByCustomer Boolean @default(false)
  readBySeller   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

/* ------------------------------------------------------------------------ */
/*  Operations                                                               */
/* ------------------------------------------------------------------------ */

model AuditLog {
  id String @id @default(cuid())

  // Exactly one of these is set, depending on who acted.
  staffActor  StaffUser? @relation("AuditActorStaff", fields: [staffActorId], references: [id])
  staffActorId String?
  userActor   User?      @relation("AuditActorUser", fields: [userActorId], references: [id])
  userActorId  String?
  actorLabel   String // denormalised display name, survives account deletion

  action   String // e.g. product.update, seller.approve, payout.paid
  resource String // e.g. product:aeris-wireless-headphones
  detail   Json?
  ip       String?

  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([staffActorId])
  @@index([resource])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
